    {
      "parameters": {
        "jsCode": "const driveItems = $(\"Search files and folders1\").all().map(item => item.json);\n\nlet sheetItems = [];\nif ($(\"Get row(s) in sheet\").isExecuted) {\n    sheetItems = $(\"Get row(s) in sheet\").all().map(item => item.json);\n}\nconst registeredIds = new Set();\nfor (const item of sheetItems) {\n    if (item.ID) {\n        registeredIds.add(item.ID);\n    }\n}\nconst newFiles = driveItems.filter(file => !registeredIds.has(file.id));\nreturn newFiles.map(file => ({ json: file }));"
      },
